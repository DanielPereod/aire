e],"widgets_values_named":{"x":0,"y":0,"resize_source":true},"color":"#232","bgcolor":"#353"},{"id":130,"type":"SaveImage","pos":[2020,2480],"size":[540,640],"flags":{},"order":44,"mode":4,"inputs":[{"localized_name":"imágenes","name":"images","type":"IMAGE","link":73},{"localized_name":"prefijo_nombre_archivo","name":"filename_prefix","type":"STRING","widget":{"name":"filename_prefix"},"link":null}],"outputs":[{"localized_name":"images","name":"images","type":"IMAGE","links":null}],"title":"Guardado - retoque","properties":{"Node name for S&R":"SaveImage"},"widgets_values":["Architecture/01_Master_Retouch"],"widgets_values_named":{"filename_prefix":"Architecture/01_Master_Retouch"},"color":"#232","bgcolor":"#353"},{"id":131,"type":"Image Comparer (rgthree)","pos":[2600,2480],"size":[540,640],"flags":{},"order":45,"mode":4,"inputs":[{"dir":3,"name":"image_a","type":"IMAGE","link":74},{"dir":3,"name":"image_b","type":"IMAGE","link":75}],"outputs":[{"dir":4,"name":"images","type":"IMAGE","slot_index":0,"links":[]}],"title":"CHECK RETOQUE - antes / despues","properties":{"comparer_mode":"Slide","Node name for S&R":"Image Comparer (rgthree)"},"widgets_values":[[]],"widgets_values_named":{"rgthree_comparer":{"images":[]}},"color":"#232","bgcolor":"#353"},{"id":132,"type":"Fast Groups Bypasser (rgthree)","pos":[2620,40],"size":[420,130],"flags":{},"order":7,"mode":0,"inputs":[],"outputs":[{"name":"OPT_CONNECTION","type":"*","links":null}],"title":"ACTIVAR / DESACTIVAR UPSCALE E INPAINT","properties":{"matchColors":"","matchTitle":"^(2|3)","showNav":true,"showAllGraphs":true,"sort":"position","customSortAlphabet":"","toggleRestriction":"default"}},{"id":133,"type":"Note","pos":[2620,220],"size":[520,900],"flags":{},"order":8,"mode":0,"inputs":[],"outputs":[],"title":"UPSCALE + INPAINT - LEEME","properties":{"Node name for S&R":"Note"},"widgets_values":["Los grupos 2 y 3 vienen DESACTIVADOS: el render (grupo 1) funciona igual que antes. Actívalos con el interruptor de arriba.\n\nFLUJO RECOMENDADO\n1) Genera con el grupo 1 hasta aprobar un render (semilla fija).\n2) Activa 2 · UPSCALE y vuelve a lanzar. El render sale de caché (misma semilla), solo se calcula el upscale.\n   - Escala lanczos a 1.6 MP y hace un refinado corto con Klein usando el render aprobado como referencia.\n   - DETALLE: 0.10 = muy fiel, 0.17 = por defecto, 0.25 = más textura (puede alterar detalles finos).\n   - 2.0 MP es posible en 8 GB pero más lento; si da falta de memoria baja a 1.3.\n3) Desactiva 2, activa 3 · INPAINT. Carga el PNG upscalado (o el render), clic derecho > Open in MaskEditor, pinta la zona, Save.\n   - Escribe en el PROMPT DE RETOQUE solo lo que cambia.\n   - FUERZA: 0.3 corrige textura/color, 0.5 por defecto, 0.8-1.0 sustituye el objeto.\n   - Tamaño de trabajo: pon los MP de la imagen cargada (1.6 si viene del upscale; 0.55 si es el render base).\n   - Fuera de la máscara los píxeles se conservan exactos (composite final).\n   - Retoques pequeños y uno a uno: guarda, recarga el resultado y sigue.\n\nSin modelos ESRGAN instalados: el upscale usa lanczos + Flux. Si instalas 4x-UltraSharp en Models/ESRGAN se puede añadir antes del paso 1 del upscale."],"widgets_values_named":{"text":"Los grupos 2 y 3 vienen DESACTIVADOS: el render (grupo 1) funciona igual que antes. Actívalos con el interruptor de arriba.\n\nFLUJO RECOMENDADO\n1) Genera con el grupo 1 hasta aprobar un render (semilla fija).\n2) Activa 2 · UPSCALE y vuelve a lanzar. El render sale de caché (misma semilla), solo se calcula el upscale.\n   - Escala lanczos a 1.6 MP y hace un refinado corto con Klein usando el render aprobado como referencia.\n   - DETALLE: 0.10 = muy fiel, 0.17 = por defecto, 0.25 = más textura (puede alterar detalles finos).\n   - 2.0 MP es posible en 8 GB pero más lento; si da falta de memoria baja a 1.3.\n3) Desactiva 2, activa 3 · INPAINT. Carga el PNG upscalado (o el render), clic derecho > Open in MaskEditor, pinta la zona, Save.\n   - Escribe en el PROMPT DE RETOQUE solo lo que cambia.\n   - FUERZA: 0.3 corrige textura/color, 0.5 por defecto, 0.8-1.0 sustituye el objeto.\n   - Tamaño de trabajo: pon los MP de la imagen cargada (1.6 si viene del upscale; 0.55 si es el render base).\n   - Fuera de la máscara los píxeles se conservan exactos (composite final).\n   - Retoques pequeños y uno a uno: guarda, recarga el resultado y sigue.\n\nSin modelos ESRGAN instalados: el upscale usa lanczos + Flux. Si instalas 4x-UltraSharp en Models/ESRGAN se puede añadir antes del paso 1 del upscale."},"color":"#432","bgcolor":"#653"},{"id":8,"type":"CLIPTextEncode","pos":[176.82427358030415,-33.58000085328726],"size":[370,320],"flags":{},"order":11,"mode":0,"inputs":[{"localized_name":"clip","name":"clip","type":"CLIP","link":5},{"localized_name":"texto","name":"text","type":"STRING","widget":{"name":"text"},"link":null}],"outputs":[{"localized_name":"ACONDICIONAMIENTO","name":"CONDITIONING","type":"CONDITIONING","slot_index":0,"links":[6,28]}],"title":"DESIGN BRIEF - keep identical between views","properties":{"Node name for S&R":"CLIPTextEncode"},"widgets_values":["Convert image 1 into a photorealistic interior architectural photograph. Preserve the exact camera position, perspective, framing and room geometry of image 1. Keep all walls, openings, ceiling heights, built-in cabinetry, furniture shapes, counts and positions. Preserve object identities and material assignments. Do not redesign the room, move objects, add furniture, crop the image or change the lens. Remove drawn black sketch outlines. Lighting: mid-afternoon sunlight entering low from the side, casting long soft dappled tree-leaf shadows across the floor, the cabinet fronts and the table. Bright sunlit patches against gentle shade, soft warm bounce light, lifted shadows, airy and luminous atmosphere, slight natural haze.  Realistic roughness, subtle reflections on countertops and appliances, crisp contact shadows. High-end editorial interior photography, full-frame camera, natural look. Return one full-frame image, no collage or text."],"widgets_values_named":{"text":"Convert image 1 into a photorealistic interior architectural photograph. Preserve the exact camera position, perspective, framing and room geometry of image 1. Keep all walls, openings, ceiling heights, built-in cabinetry, furniture shapes, counts and positions. Preserve object identities and material assignments. Do not redesign the room, move objects, add furniture, crop the image or change the lens. Remove drawn black sketch outlines. Lighting: mid-afternoon sunlight entering low from the side, casting long soft dappled tree-leaf shadows across the floor, the cabinet fronts and the table. Bright sunlit patches against gentle shade, soft warm bounce light, lifted shadows, airy and luminous atmosphere, slight natural haze.  Realistic roughness, subtle reflections on countertops and appliances, crisp contact shadows. High-end editorial interior photography, full-frame camera, natural look. Return one full-frame image, no collage or text."},"color":"#233","bgcolor":"#344"},{"id":15,"type":"SamplerCustomAdvanced","pos":[976.8242735803045,-33.58000085328726],"size":[340,365.984375],"flags":{},"order":32,"mode":0,"inputs":[{"localized_name":"ruido","name":"noise","type":"NOISE","link":14},{"localized_name":"guía","name":"guider","type":"GUIDER","link":15},{"localized_name":"muestreador","name":"sampler","type":"SAMPLER","link":16},{"localized_name":"sigmas","name":"sigmas","type":"SIGMAS","link":17},{"localized_name":"imagen_latente","name":"latent_image","type":"LATENT","link":18}],"outputs":[{"localized_name":"salida","name":"output","type":"LATENT","slot_index":0,"links":[19,29]},{"localized_name":"salida_sin_ruido","name":"denoised_output","type":"LATENT","slot_index":1,"links":[]}],"title":"Render","properties":{"Node name for S&R":"SamplerCustomAdvanced"},"widgets_values":[],"widgets_values_named":{},"color":"#232","bgcolor":"#353"},{"id":17,"type":"SaveImage","pos"